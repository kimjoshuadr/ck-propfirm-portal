# CK CRM API base URL (the CRM's origin, no trailing slash).
# Dev default: http://localhost:3000 — the CRM dev server.
VITE_CRM_API=http://localhost:3000

# Tenant/org resolution for the bearer-token login. On the CRM's
# platform-domain host, POST /api/portal_api/portal/token requires the caller
# to name the tenant (or the organization) in the body — the server resolves
# and cross-checks it. Leave empty when the CRM serves the portal from a
# custom domain that already resolves the tenant by hostname.
VITE_CRM_TENANT_ID=
VITE_CRM_ORG_ID=
